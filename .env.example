# OpenAI API Key (or OpenRouter, Groq, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL of any OpenAI-compatible provider:
#   OpenAI (default):    https://api.openai.com/v1
#   OpenRouter:          https://openrouter.ai/api/v1
#   Groq:                https://api.groq.com/openai/v1
#   Ollama (local):      http://host.docker.internal:11434/v1
#   LM Studio (local):   http://host.docker.internal:1234/v1
#   vLLM:                http://server:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Single model used for all pipeline roles (optional)
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API Key (if using OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Direct Gemini API key (if using Gemini image features)
GEMINI_API_KEY=your_gemini_api_key_here

# Studio auth token (VTD-003) — WYMAGANY w Dockerze.
# Gdy ustawiony, endpointy (poza /health, /login i statykami /static) wymagają
# nagłówka X-VTD-Token albo cookie vtd_token (nadawanego po zalogowaniu na /login).
# Parametr ?token= NIE jest honorowany (GF-014): query param wycieka do logów
# i historii przeglądarki. Gdy pusty, Studio binduje 127.0.0.1 i loguje ostrzeżenie.
VTD_AUTH_TOKEN=
